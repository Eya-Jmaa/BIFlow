# --- Application ---
APP_ENV=development
APP_NAME=BIFlow
LOG_LEVEL=INFO
LOG_JSON=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=http://localhost:8000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=biflow
POSTGRES_USER=biflow
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://biflow:change-me-in-production@postgres:5432/biflow

# Read-only role used for generated analytical queries
ANALYTICS_DATABASE_URL=postgresql+psycopg://biflow_analytics:change-me-in-production@postgres:5432/biflow

# --- Redis / worker ---
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=biflow

# --- Storage ---
DATA_DIR=/data
MAX_UPLOAD_MB=200
PROFILE_SAMPLE_ROWS=50000
LLM_SAMPLE_ROWS=20

# --- LLM (never expose these to the frontend) ---
# LLM_PROVIDER must match the key you actually set below. A mismatch is not an
# error: every agent falls back to deterministic output and the run still
# produces correct numbers. GET /health reports whether the LLM is active.
LLM_PROVIDER=openai
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1

# Pipeline still computes deterministic analytics if no LLM key is set.
LLM_ENABLED=true

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string
UPLOAD_ALLOWED_EXTENSIONS=csv,parquet,xlsx,xls
